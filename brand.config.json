{
    "brand_name": "YourBrand",
    "brand_domain": "yourbrand.com",
    "brand_hostname": {
        "staging": "staging.yourbrand.com/dashboard",
        "production": "yourbrand.com/dashboard"
    },
    "domain_name": "YourBrand.com",
    "colors": {
        "primary": "#7C3AED",
        "secondary": "#A78BFA",
        "tertiary": "#08080F",
        "success": "#2d9f7b",
        "danger": "#b83240",
        "warning": "#a68b39",
        "info": "#4a6fa5",
        "neutral": "#717184",
        "black": "#08080F",
        "white": "#ffffff",
        "grey": {
            "50": "#F0EEF8",
            "100": "#E4E0F4",
            "200": "#C9C2E8",
            "300": "#A898D4",
            "400": "#7B6BAE",
            "500": "#5A4D8A",
            "600": "#3E3568",
            "700": "#282050",
            "800": "#16123A",
            "900": "#08080F"
        }
    },
    "typography": {
        "font_family": {
            "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
            "secondary": "Georgia, 'Times New Roman', Times, serif",
            "monospace": "'Courier New', Courier, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "DERIV ANALYSING HUB",
        "logo": {
            "type": "component",
            "component_name": "BrandLogo",
            "alt_text": "DERIV ANALYSING HUB",
            "link_url": "/",
            "show_text": false,
            "text": "DERIV ANALYSING HUB"
        },
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "bot.yourbrand.com"
            },
            "staging": {
                "com": "staging-bot.yourbrand.com"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
