{
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "pipstrades.pro" }],
            "destination": "https://www.pipstrades.pro/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
